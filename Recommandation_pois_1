      "3        1   4     3.5\n",
      "4        1   7     4.0\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from scipy.spatial import KDTree\n",
    "from surprise import Dataset, KNNBasic\n",
    "\n",
    "# Chargement des POIs\n",
    "pois = pd.read_csv(\"pois.csv\")\n",
    "print(pois.head())\n",
    "\n",
    "# Chargement des notes (exemple minimal)\n",
    "ratings = pd.read_csv(\"ratings.csv\")\n",
    "print(ratings.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1407a930-aaa3-4caf-840a-8063456c39b6",
   "metadata": {},
   "source": [
    "**Étape 1 : Trouver les POIs les plus proches (KDTree)**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2cde50d3-c4a9-490f-9b09-1f0d00f9b936",
   "metadata": {},
   "source": [
    "Calculez la distance entre l'utilisateur et tous les POIs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "cbabd391-a294-4e22-a531-bd0749606d33",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "    ID               Place_Name        Lat      Long  distance\n",
      "3    4           Parking_Wilaya  30.421990 -9.604948  0.000003\n",
      "68  69         Jardin_Belvedere  30.420528 -9.606165  0.001906\n",
      "4    5      Rue_de_Paris_PLACE1  30.424987 -9.604443  0.003037\n",
      "7    8  Rue_de_Stockholm_PLACE1  30.424570 -9.602984  0.003240\n",
      "5    6     Rue_Echouhada_PLACE1  30.425052 -9.606654  0.003504\n"
     ]
    }
   ],
   "source": [
    "def get_nearest_pois(user_lat, user_lon, k=5):\n",
    "\n",
    "    # Créer un KDTree pour une recherche rapide\n",
    "\n",
    "    coords = pois[[\"Lat\", \"Long\"]].values\n",
    "\n",
    "    kdtree = KDTree(coords)\n",
    "\n",
    "    \n",
    "\n",
    "    # Trouver les k POIs les plus proches\n",
    "    # k est le nbr de pois à retourner\n",
    "\n",
    "    distances, indices = kdtree.query([user_lat, user_lon], k=k)\n",
    "\n",
    "    nearest_pois = pois.iloc[indices].copy()\n",
    "\n",
    "    nearest_pois[\"distance\"] = distances\n",
    "\n",
    "    return nearest_pois\n",
    "\n",
    "\n",
    "\n",
    "# Test : Position utilisateur (ex: Paris)\n",
    "\n",
    "nearest_pois = get_nearest_pois(30.421992,-9.604945, k=5)\n",
    "\n",
    "print(nearest_pois)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6ffdc8b9-93cb-44ac-8891-537c4f7701f5",
   "metadata": {},
   "source": [
    "**Étape 2: scoring de sécurité KNN collaboratif**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7f03a2ad-33e9-485f-b8d7-7b8f3c680c79",
   "metadata": {},
   "source": [
    "Si un POI a une note prédite, utilisez-la. Sinon, donnez un score par défaut."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "9c5add09-efe5-4c01-a376-23356346c0e3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Computing the msd similarity matrix...\n",
      "Done computing similarity matrix.\n",
      "                 Place_Name  distance  safety_score\n",
      "3            Parking_Wilaya  0.000003      3.832718\n",
      "68         Jardin_Belvedere  0.001906      3.888235\n",
      "4       Rue_de_Paris_PLACE1  0.003037      3.888235\n",
      "7   Rue_de_Stockholm_PLACE1  0.003240      3.888235\n",
      "5      Rue_Echouhada_PLACE1  0.003504      3.888235\n"
     ]
    }
   ],
   "source": [
    "from surprise import Dataset, Reader, KNNBasic\n",
    "\n",
    "# Exemple : si tes notes vont de 1 à 5\n",
    "\n",
    "reader = Reader(rating_scale=(1, 5))\n",
    "# Entraîner le KNN avec les notes existantes\n",
    "def train_knn():\n",
    "    # Charger les données de notation (ratings) au format Surprise\n",
    "    data = Dataset.load_from_df(ratings, reader)\n",
    "    \n",
    "    # Initialiser l'algorithme KNN en mode item-item (comparaison entre POIs)\n",
    "    algo = KNNBasic(sim_options={'user_based': False})\n",
    "    \n",
    "    # Entraîner le modèle sur l'ensemble des données\n",
    "    algo.fit(data.build_full_trainset())\n",
    "    \n",
    "    # Retourner le modèle entraîné\n",
    "    return algo\n",
    "\n",
    "# Entraîner et stocker le modèle KNN\n",
    "knn = train_knn()\n",
    "\n",
    "\n",
    "# Prédire un score de sécurité pour un POI donné\n",
    "def get_safety_score(ID):\n",
    "    try:\n",
    "        # Prédire la note du POI pour un utilisateur fictif (uid=1)\n",
    "        pred = knn.predict(uid=1, iid=ID)\n",
    "        \n",
    "        # Retourner la note prédite comme score de sécurité\n",
    "        return pred.est\n",
    "    except:\n",
    "        # Si une erreur survient (ex. : POI inconnu), retourner un score par défaut\n",
    "        return 3.0\n",
    "\n",
    "\n",
    "# Calculer et ajouter le score de sécurité à chaque POI proche\n",
    "nearest_pois[\"safety_score\"] = nearest_pois[\"ID\"].apply(get_safety_score)\n",
    "\n",
    "# Afficher les POIs avec leur nom, distance et score de sécurité\n",
    "print(nearest_pois[[\"Place_Name\", \"distance\", \"safety_score\"]])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7dfd4b4a-f010-4455-94a3-cda46c9ad82c",
   "metadata": {},
   "source": [
    "**Étape 3: combinaison Distance + score**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "28249351-e40e-465c-8aa7-3818d91a6528",
   "metadata": {},
   "source": [
    "Priorisez les POIs proches et bien notés avec un score hybride"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "5de96713-e54a-43da-ad2b-b6a8852d03cc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "                 Place_Name  distance  safety_score   hybrid_score\n",
      "3            Parking_Wilaya  0.000003      3.832718  201962.624913\n",
      "68         Jardin_Belvedere  0.001906      3.888235     368.457572\n",
      "4       Rue_de_Paris_PLACE1  0.003037      3.888235     231.682694\n",
      "7   Rue_de_Stockholm_PLACE1  0.003240      3.888235     217.244804\n",
      "5      Rue_Echouhada_PLACE1  0.003504      3.888235     200.915382\n"
     ]
    }
   ],
   "source": [
    "def hybrid_score(row, alpha=0.7):\n",
    "    # alpha=0.7 : Poids de la distance (30% pour le score de sécurité)\n",
    "    return (alpha * (1 / row[\"distance\"])) + ((1 - alpha) * row[\"safety_score\"])\n",
    "\n",
    "nearest_pois[\"hybrid_score\"] = nearest_pois.apply(hybrid_score, axis=1)\n",
    "recommendation = nearest_pois.sort_values(\"hybrid_score\", ascending=False)\n",
    "print(recommendation[[\"Place_Name\", \"distance\", \"safety_score\", \"hybrid_score\"]])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2bd8ca32-e276-4b55-bc56-1a0c5dd6689a",
   "metadata": {},
   "source": [
    "**Résultat finale**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b7ffaef8-47fe-4a5b-bc12-13fa3f1a83ee",
   "metadata": {},
   "source": [
    "**Input** :Position utilisateur (lat,lon)"
