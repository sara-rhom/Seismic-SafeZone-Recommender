   "source": [
    "def recommend_safe_poi(user_lat, user_lon):\n",
    "    nearest = get_nearest_pois(user_lat, user_lon, k=10)\n",
    "    nearest[\"safety_score\"] = nearest[\"ID\"].apply(get_safety_score)\n",
    "    nearest[\"hybrid_score\"] = nearest.apply(hybrid_score, axis=1)\n",
    "    return nearest.sort_values(\"hybrid_score\", ascending=False)\n",
    "\n",
    "# Exemple :\n",
    "recommendation = recommend_safe_poi(30.421992,-9.604945)\n",
    "print(recommendation.head(3))"
   ]
